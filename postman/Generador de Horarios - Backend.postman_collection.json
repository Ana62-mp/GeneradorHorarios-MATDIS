    {
      "name": "02 - Flujo CRUD automático",
      "item": [
        {
          "name": "1. Crear materia básica",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Materia creada: HTTP 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('La respuesta contiene la materia creada', function () {",
                  "    pm.expect(json.course).to.be.an('object');",
                  "    pm.expect(json.course.name).to.eql('Base de datos básica');",
                  "});",
                  "",
                  "if (json.course && json.course.id) {",
                  "    pm.collectionVariables.set('basicCourseId', json.course.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Base de datos básica\",\n  \"section\": \"A\",\n  \"day\": \"LUNES\",\n  \"startTime\": \"08:00\",\n  \"endTime\": \"10:00\",\n  \"modality\": \"PRESENCIAL\",\n  \"difficulty\": \"MEDIA\",\n  \"credits\": 4,\n  \"prerequisiteIds\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Crear materia avanzada con prerrequisito",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('basicCourseId')) {",
                  "    throw new Error('Ejecuta primero: Crear materia básica');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Materia avanzada creada: HTTP 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Incluye el prerrequisito', function () {",
                  "    pm.expect(json.course.prerequisites).to.be.an('array');",
                  "    pm.expect(json.course.prerequisites.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "if (json.course && json.course.id) {",
                  "    pm.collectionVariables.set('advancedCourseId', json.course.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Base de datos avanzada\",\n  \"section\": \"A\",\n  \"day\": \"MARTES\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"12:00\",\n  \"modality\": \"VIRTUAL\",\n  \"difficulty\": \"ALTA\",\n  \"credits\": 4,\n  \"prerequisiteIds\": [{{basicCourseId}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
