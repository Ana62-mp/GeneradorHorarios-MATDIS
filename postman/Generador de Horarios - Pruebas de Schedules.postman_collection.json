          "name": "Detectar cruce de horarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const programacionId = String(pm.collectionVariables.get('programacionId'));",
                  "const redesId = String(pm.collectionVariables.get('redesId'));",
                  "const objetivo = json.schedules.find(item => {",
                  "    const ids = item.courses.map(course => String(course.id));",
                  "    return ids.includes(programacionId) && ids.includes(redesId);",
                  "});",
                  "",
                  "pm.test('La combinación cruzada fue descartada', function () {",
                  "    pm.expect(objetivo).to.exist;",
                  "    pm.expect(objetivo.valid).to.eql(false);",
                  "    pm.expect(objetivo.reasons.join(' ')).to.include('cruces');",
                  "});"
                ]
