              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const objetivo = json.schedules.find(item =>",
                  "    item.courses.some(course => String(course.id) === String(pm.collectionVariables.get('bdAvanzadaId')))",
                  ");",
                  "",
                  "pm.test('La materia avanzada se descarta sin prerrequisito', function () {",
                  "    pm.expect(objetivo).to.exist;",
                  "    pm.expect(objetivo.valid).to.eql(false);",
                  "    pm.expect(objetivo.reasons.join(' ')).to.include('prerrequisitos');",
