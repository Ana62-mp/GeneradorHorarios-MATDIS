    {
      "name": "03 - Probar generación de horarios",
      "item": [
        {
          "name": "Generar horarios generales",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Incluye estadísticas combinatorias', function () {",
                  "    pm.expect(json.totalCourses).to.be.a('number');",
                  "    pm.expect(json.selectedAmount).to.eql(3);",
                  "    pm.expect(json.totalCombinations).to.be.a('number');",
                  "    pm.expect(json.schedules).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Válidos + descartados = combinaciones', function () {",
                  "    pm.expect(json.validSchedules + json.discardedSchedules).to.eql(json.totalCombinations);",
                  "});",
                  "",
                  "pm.test('Muestra el modelo matemático', function () {",
                  "    pm.expect(json.mathematicalModel).to.be.an('object');",
                  "    pm.expect(json.mathematicalModel.combination).to.include('C(');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numberOfCourses\": 3,\n  \"maximumCredits\": 12,\n  \"maximumDifficultCourses\": 2,\n  \"requiredCourseIds\": [{{programacionId}}],\n  \"completedCourseIds\": [],\n  \"requiredModality\": \"CUALQUIERA\",\n  \"avoidTimeConflicts\": true,\n  \"validatePrerequisites\": true\n}",
